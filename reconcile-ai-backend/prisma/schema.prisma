generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  clerkId      String              @unique
  email        String              @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  documents    FinancialDocument[]
  transactions Transaction[]
  agentRuns    AgentRun[]

  subscriptions Subscription[]
  anomalies     Anomaly[]

  recommendations Recommendation[]
  actions         Action[]
}

enum DocumentType {
  BANK_STATEMENT
  UPI_STATEMENT
  CREDIT_CARD_STATEMENT
  RECEIPT
  CSV
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}


model FinancialDocument {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  fileUrl      String
  fileName     String
  fileType     DocumentType
  status       DocumentStatus @default(UPLOADED)
  transactions Transaction[]
  createdAt    DateTime       @default(now())
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  documentId  String?
  document    FinancialDocument? @relation(fields: [documentId], references: [id])
  merchant    String
  amount      Float
  category    String?
  date        DateTime
  description String?
  createdAt   DateTime          @default(now())
  anomalies Anomaly[]
}



model AgentRun {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  status    String
  summary   Json
  createdAt DateTime @default(now())
}




model Subscription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  merchant      String
  amount        Float
  frequency     String
  lastSeen      DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

enum AnomalyType {
  DUPLICATE
  UNUSUAL_SPENDING
  FORGOTTEN_SUBSCRIPTION
}

model Anomaly {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  type          AnomalyType
  explanation   String
  confidence    Float
  resolved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  relatedTransactionId String?
  recommendations Recommendation[]
}


enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
}

enum ActionType {
  CANCELLATION_EMAIL
  NEGOTIATION_MESSAGE
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  anomalyId   String?
  anomaly     Anomaly? @relation(fields: [anomalyId], references: [id])
  text        String
  createdAt   DateTime @default(now())
  action      Action?
}

model Action {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  recommendationId String          @unique
  recommendation   Recommendation  @relation(fields: [recommendationId], references: [id])
  type             ActionType
  draftText        String
  finalText        String?
  status           ActionStatus    @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}